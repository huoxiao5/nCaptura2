<Window x:Class="Captura.RecordingStatusBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight">
    <Border Background="#FFEB3B" BorderBrush="#FF999999" BorderThickness="1,1,1,0" Padding="4,2">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Name="DurationText" Text="00:00:00" Foreground="Black" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0" FontWeight="Bold"/>
            <TextBlock Name="FileSizeText" Text="0 KB" Foreground="Black" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,8,0"/>

            <!-- 新增：定时信息显示 -->
            <TextBlock Name="TimerInfoText" Text="" Foreground="#FFD32F2F" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0,8,0" FontWeight="Bold" Visibility="Collapsed"/>

            <!-- 隐藏的拖动区域 -->
            <Border Background="Transparent" Cursor="SizeAll" Width="15" Height="15" PreviewMouseLeftButtonDown="DragArea_MouseDown" Margin="0,0,4,0"/>

            <Button Name="PauseButton" Width="24" Height="24" Margin="2,0" ToolTip="暂停" Click="PauseButton_Click" Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <Grid Width="16" Height="16">
                                <Path Name="PauseIcon" Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                      Data="M 4,3 L 7,3 L 7,13 L 4,13 Z M 10,3 L 13,3 L 13,13 L 10,13 Z" Visibility="Visible"/>
                                <Path Name="PlayIcon" Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                      Data="M 4,2 L 14,8 L 4,14 Z" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>