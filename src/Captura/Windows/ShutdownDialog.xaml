<Window x:Class="Captura.ShutdownDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录制完成" Width="360" Height="160"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow" ResizeMode="NoResize" Topmost="True">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="录制已结束，文件已保存！" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock HorizontalAlignment="Center" FontSize="13">
                <Run Text="电脑将在 "/>
                <Run Name="CountdownRun" Text="60" Foreground="Red" FontWeight="Bold" FontSize="16"/>
                <Run Text=" 秒后关机。"/>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="取消关机" Width="100" Height="30" Margin="10,0" Click="Cancel_Click" />
            <Button Content="立即关机" Width="100" Height="30" Margin="10,0" Click="ShutdownNow_Click" />
        </StackPanel>
    </Grid>
</Window>