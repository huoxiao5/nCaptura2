<Window x:Class="Captura.PauseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录制已暂停"
        Width="320" Height="160"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- 新增一行放自动关机按钮 -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="录制已暂停，请选择操作：" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>

        <!-- 第一排按钮：继续、保存、丢弃 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="继续" Width="80" Height="28" Margin="6,0" Click="Resume_Click"/>
            <Button Content="保存" Width="80" Height="28" Margin="6,0" Click="Save_Click"/>
            <Button Content="丢弃" Width="80" Height="28" Margin="6,0" Click="Discard_Click"/>
        </StackPanel>

        <!-- 第二排按钮：自动关机切换开关 -->
        <Button Name="ToggleShutdownBtn" Grid.Row="2" 
                Content="开启录制结束后自动关机" 
                Width="180" Height="26" 
                Click="ToggleShutdown_Click" 
                HorizontalAlignment="Center"
                Background="#FFF5F5F5" BorderBrush="#FFCCCCCC"/>
    </Grid>
</Window>